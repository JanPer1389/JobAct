# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# This is the entire configuration surface: the demo backend has no
# database, cache, object storage, or auth provider to configure.

# --- Qwen / DashScope (the only AI connector) --------------------------
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_REQUEST_TIMEOUT_SECONDS=600

# --- Local USD/RUB snapshot (CBR, effective 2026-08-26) ----------------
USD_RUB_RATE=84.4635
USD_RUB_RATE_DATE=2026-08-26
USD_RUB_RATE_SOURCE=CBR

# --- CORS / allowed origins (comma-separated) --------------------------------
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
