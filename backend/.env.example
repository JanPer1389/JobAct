# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Qwen / DashScope (the only AI connector) --------------------------
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_REQUEST_TIMEOUT_SECONDS=600

# --- Local USD/RUB snapshot (CBR, effective 2026-08-26) ----------------
USD_RUB_RATE=84.4635
USD_RUB_RATE_DATE=2026-08-26
USD_RUB_RATE_SOURCE=CBR

# --- Postgres -----------------------------------------------------------
POSTGRES_HOST=localhost
# 5433, not 5432: docker-compose.yml maps the container's Postgres to host
# port 5433 to avoid colliding with a native Postgres install some dev
# machines already run on 5432 (a second listener on 5432 causes silent,
# intermittent connection resets, not a clean bind error). Keep this in
# sync with docker-compose.yml's postgres port mapping.
POSTGRES_PORT=5433
POSTGRES_USER=jobact
POSTGRES_PASSWORD=jobact
POSTGRES_DB=jobact
# Local Compose Postgres has no SSL configured. Leave false for local/dev;
# set true once the target Postgres actually terminates TLS.
POSTGRES_SSL=false

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ENDPOINT_URL=http://localhost:9000
# Public origin embedded in presigned URLs returned to the browser.
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=jobact
MINIO_SECRET_KEY=jobact-secret
MINIO_BUCKET_NAME=jobact-reports

# --- Google OAuth (not wired up until the auth task) -------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# --- Session cookie ---------------------------------------------------------
SESSION_COOKIE_NAME=jobact_session
SESSION_SECRET=change-me-to-a-random-secret

# --- CORS / allowed origins (comma-separated) --------------------------------
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
